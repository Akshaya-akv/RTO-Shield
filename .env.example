# ==============================================================
# RTO-SHIELD ENVIRONMENT CONFIGURATION
# ==============================================================

# 1. Supabase PostgreSQL & API
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Server-side only (NEVER expose to browser/client-side)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# 2. Google Gemini AI API
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# 3. Application URL (Defaults to localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
